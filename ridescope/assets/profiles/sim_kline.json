        {
          "id": "bleed_front",
          "name": "Bleed front brake circuit",
          "kind": "bleed",
          "description": "Cycles the ABS pressure modulator so trapped air leaves the front circuit.",
          "preconditions": {
            "extra": [
              "Bike is on its centre stand",
              "Bleeding bottle is connected to the front calipers"
            ]
          },
          "steps": [
            {
              "op": "security"
            },
            {
              "op": "prompt",
              "message": "Open the front caliper bleed screws and keep the reservoir topped up."
            },
            {
              "op": "routine",
              "ident": "0x01",
              "label": "Cycling front modulator"
            },
            {
              "op": "prompt",
              "message": "Pull and hold the front brake lever, then tap Continue."
            },
            {
              "op": "routine",
              "ident": "0x01",
              "label": "Cycling front modulator (2)"
            },
            {
              "op": "prompt",
              "message": "Close the bleed screws and top up the reservoir to MAX."
            }
          ],
          "successMessage": "Check the lever is firm before you ride.",
          "verified": true
        },
        {
          "id": "bleed_rear",
          "name": "Bleed rear brake circuit",
          "kind": "bleed",
          "description": "Cycles the ABS pressure modulator so trapped air leaves the rear circuit.",
